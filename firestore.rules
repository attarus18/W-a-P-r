/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. All
 * data, including user profiles, products, and calculations, is stored within
 * a user-specific data tree. Access is granted only to the authenticated owner
 * of that data tree, ensuring complete data privacy between users.
 *
 * Data Structure: The data is organized hierarchically under the /users/{userId}
 * path. All user-related subcollections, such as 'products' and
 * 'productionCostCalculations', are nested under their respective user document.
 * This structure enables simple, path-based security rules.
 *
 * Key Security Decisions:
 * - User Enumeration is explicitly DISALLOWED by denying list access on the
 *   top-level /users collection.
 * - All write operations (create, update, delete) are restricted to the
 *   document owner.
 * - All read operations (get, list) on user-specific data are restricted to the
 *   document owner. There is no public or shared data in this model.
 * - The default security posture is to deny all access unless explicitly granted.
 *
 * Denormalization for Authorization: The data model is inherently designed for
 * efficient authorization. The user's UID is part of the document path for all
 * user-specific data, eliminating the need for slow and costly `get()` calls to
 * check ownership on related documents. Each subcollection document also stores
 * a `userId` field, which is used to enforce relational integrity on writes.
 *
 * Structural Segregation: This pattern is fully embraced by nesting all private
 * user data within their own document tree under /users/{userId}. This inherently
 * separates one user's data from another's, providing a secure and performant
 * foundation for the rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the primary function for enforcing data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for safe updates and deletes.
     * Prevents operations on documents that do not exist.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that the user ID in the document body matches the user ID in the path.
     * Enforces data consistency for a user's root document.
     */
    function userDocumentIsValid(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Ensures the user ID in a document's body cannot be changed after creation.
     */
    function userDocumentIsImmutable() {
      return request.resource.data.id == resource.data.id;
    }
    
    /**
     * Validates that the userId field in a subcollection document matches the user ID in the path.
     * Enforces relational integrity on creation.
     */
    function subcollectionDocumentIsValid(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Ensures the userId field in a subcollection document cannot be changed after creation.
     */
    function subcollectionDocumentIsImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Manages user profile documents. Only the owner can read or
     *   write their own profile. Listing all users is forbidden.
     * @path /users/{userId}
     * @allow (create) An authenticated user creates their own profile document
     *   for the first time, where `userId` matches their `auth.uid`.
     * @deny (list) An authenticated user tries to list all documents in the
     *   `/users` collection to prevent user enumeration.
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && userDocumentIsValid(userId);
      allow update: if isExistingOwner(userId) && userDocumentIsImmutable();
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages a user's inventory of products. Only the owner
       *   can create, read, update, or delete their own products.
       * @path /users/{userId}/products/{productId}
       * @allow (create) An authenticated user adds a new product to their own
       *   inventory (`/users/USER_A/products/PROD_123`).
       * @deny (get) A different user (`USER_B`) tries to read a product from
       *   another user's inventory (`/users/USER_A/products/PROD_123`).
       * @principle Enforces strict data ownership within a user-specific subcollection.
       */
      match /products/{productId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && subcollectionDocumentIsValid(userId);
        allow update: if isExistingOwner(userId) && subcollectionDocumentIsImmutable();
        allow delete: if isExistingOwner(userId);
      }
      
      /**
       * @description Manages a user's sales records. Only the owner
       *   can create and read their own sales. Updates and deletes are disallowed
       *   to maintain a permanent audit trail.
       * @path /users/{userId}/sales/{saleId}
       * @allow (create) An authenticated user creates a new sale record.
       * @allow (list) An authenticated user lists their own sales records.
       * @deny (update, delete) An authenticated user attempts to modify or delete
       *   an existing sale record.
       * @principle Enforces strict data ownership and immutability for financial records.
       */
      match /sales/{saleId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && subcollectionDocumentIsValid(userId);
        allow update: if false;
        allow delete: if false;
      }

      /**
       * @description Manages a user's production cost calculations. Only the
       *   owner can manage their own calculation records.
       * @path /users/{userId}/productionCostCalculations/{calculationId}
       * @allow (list) An authenticated user lists all of their past cost
       *   calculations from `/users/USER_A/productionCostCalculations`.
       * @deny (update) An authenticated user (`USER_B`) attempts to modify
       *   a calculation belonging to another user (`USER_A`).
       * @principle Enforces strict data ownership within a user-specific subcollection.
       */
      match /productionCostCalculations/{calculationId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && subcollectionDocumentIsValid(userId);
        allow update: if isExistingOwner(userId) && subcollectionDocumentIsImmutable();
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}
