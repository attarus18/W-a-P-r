<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_recipes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_recipes_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_recipes_title"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/widget_recipes_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="--"
        android:textColor="#F97316"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_recipes_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E5E7EB"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_recipes_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E5E7EB"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_recipes_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E5E7EB"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_recipes_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_loading"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />
</LinearLayout>
